- args = {group: @group.name, balance: number_to_currency(@group.ordering_balance), minimum: number_to_currency(FoodsoftConfig[:minimum_balance] || 0), recommended: number_to_currency(FoodsoftConfig[:recommended_balance] || 200), days: @days_negative, foodcoop: FoodsoftConfig[:name]}
= raw t(@days_negative > 0 ? '.reminder_text' : '.text', **args)
