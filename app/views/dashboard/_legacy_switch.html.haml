-# Opt-in hook rendered on the classic home page and the orders overview.
-# Preference lives in localStorage (key foodsoft.ui, shared by all modern
-# pages). When it says "modern" we leave right away, unless ?classic=1 forces
-# the classic page.
- content_for :head do
  :javascript
    try {
      var ls = window.localStorage;
      // one preference for all modern pages; older per-page keys still count
      var ui = ls.getItem('foodsoft.ui') || ls.getItem('foodsoft.ordering.ui') || ls.getItem('foodsoft.dashboard.ui');
      if (ui === 'modern' && !/[?&]classic=/.test(window.location.search)) {
        window.location.replace(#{dashboard_path.to_json});
      }
    } catch (e) {}
.alert.alert-info.fs-switch-alert
  %span.fs-switch-hint Party like it isn't Y2K.
  %a.btn.btn-small.btn-primary{href: dashboard_path, 'data-fs-ui' => 'modern'} Try the modern interface
