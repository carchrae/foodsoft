-# Swap page. The modern (Vue) version is rendered client-side by swap_app.js
-# from the JSON at data-url (SwapController); ?classic=1 and the "swap all"
-# page still show the classic table (_swap_classic).
- if params[:classic].present? || @swap_all
  = render 'orders/swap_classic'
- else
  - title t('.title', name: @order.name), false
  - content_for :head do
    :javascript
      document.documentElement.className += ' fs-modern';
  #swap-app{data: {url: data_swap_path(@order)}}
    .sw-boot
      %p.muted Loading #{@order.name}…
      %noscript
        .alert.alert-danger
          This page needs JavaScript.
          = link_to 'Use the classic swap page instead', swap_order_path(@order, classic: 1)
  = render 'ordering/vue_runtime', boot_selector: '.sw-boot', fallback_url: "#{swap_order_path(@order, classic: 1)}"
