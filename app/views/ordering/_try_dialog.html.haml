-# One-time "try the new design" prompt shared by the classic ordering page and
-# the classic home page. Shown only while the localStorage preference `key` is
-# unset; either answer records a choice so it never shows again.
.fs-try-backdrop{id: "fs-try-#{key.parameterize}", hidden: true}
  .fs-try{role: 'dialog', 'aria-modal' => 'true'}
    %h3= title
    %p= body
    .fs-try-actions
      %a.fs-try-btn.fs-try-primary{href: url} Try it now
      %button.fs-try-btn{type: 'button', 'data-fs-try-dismiss' => true} Not now
:javascript
  (function () {
    var key = #{key.to_json}, el = document.getElementById(#{"fs-try-#{key.parameterize}".to_json});
    if (!el) return;
    var stored = null;
    try { stored = localStorage.getItem(key); } catch (e) { return; }
    if (stored) return;
    el.hidden = false;
    el.querySelector('.fs-try-primary').addEventListener('click', function () {
      try { localStorage.setItem(key, 'modern'); } catch (e) {}
    });
    el.querySelector('[data-fs-try-dismiss]').addEventListener('click', function () {
      try { localStorage.setItem(key, 'legacy'); } catch (e) {}
      el.hidden = true;
    });
  })();
